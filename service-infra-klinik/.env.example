# Copy to service-infra-klinik/.env and fill in real values before running docker compose.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nina_dental

# --- core-api ---
APP_ENV=development
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Browser-based CORS allowlist for the admin panel (never "*" — this API
# issues auth tokens). The Flutter app isn't affected; native HTTP clients
# don't enforce CORS.
ALLOWED_ORIGINS=http://localhost:3100

# --- payment-service (Xendit) ---
XENDIT_API_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=

# --- notification-service (3rd-party WA gateway: Fonnte/Wablas/Qontak) ---
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# --- admin-frontend ---
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# --- docker-compose.prod.yml only ---
DOMAIN=ninadentalcare.com
ACME_EMAIL=admin@ninadentalcare.com
